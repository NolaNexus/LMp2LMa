{
  "$schema": "https://app.kilo.ai/config.json",
  "default_agent": "code",
  "provider": {
    "openrouter": {
      "options": {
        "baseURL": "https://openrouter.ai/api/v1"
      }
    },
    "lm_studio": {
      "options": {
        "baseURL": "http://localhost:1234/v1"
      }
    }
  },
  "mcp": {
    "anaconda": {
      "type": "remote",
      "url": "https://anaconda.com/api/mcp"
    },
    "jupyter": {
      "type": "local",
      "command": ["/home/nola/LMp2LMa/.kilo/mcp/jupyter-mcp.sh"],
      "enabled": true
    },
    "nteract": {
      "type": "local",
      "command": ["/home/nola/.local/bin/nteract", "mcp", "--no-show"],
      "enabled": true
    }
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "semantic_search": "allow",
    "kilo_memory_save": "allow",
    "kilo_memory_recall": "allow",
    "lsp": "allow",
    "skill": "allow",
    "external_directory": "ask",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "allow"
  },
  "skills": {
    "paths": [
      ".kilo/skills",
      "~/.config/kilo/skills"
    ]
  },
  "instructions": [
    "AGENTS.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true
  },
  "snapshot": true,
  "share": "manual",
  "autoupdate": "notify"
}