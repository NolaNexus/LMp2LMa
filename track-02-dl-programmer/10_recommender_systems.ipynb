        "# Cold-start: new user with only demographic/features\n",
        "def cold_start_user_recommend(age, gender, genre_prefs, k=10):\n",
        "    \"\"\"Recommend for new user using content-based features only\"\"\"\n",
        "    # Create dummy user_id (will be mapped to OOV embedding)\n",
        "    u_batch = {\n",
        "        'user_id': np.array(['new_user']),\n",
        "        'age': np.array([age], dtype=np.float32),\n",
        "        'gender': np.array([gender], dtype=np.int64),\n",
        "        'genre_prefs': genre_prefs.reshape(1, -1).astype(np.float32)\n",
        "    }\n",
        "    user_emb = user_model(u_batch).numpy().astype(np.float32)\n",
        "    faiss.normalize_L2(user_emb)\n",
        "    \n",
        "    D, I = index_hnsw.search(user_emb, k)\n",
        "    return I[0]\n",
        "\n",
        "# Simulate new user with strong action preference\n",
        "action_prefs = np.zeros(10)\n",
        "action_prefs[0] = 1.0  # genre 0 = action\n",
        "cold_recs = cold_start_user_recommend(25, 1, action_prefs, k=10)\n",
        "\n",
        "print(\"Cold-start recommendations for action-loving 25yo male:\")\n",
        "for i, item_id in enumerate(cold_recs):\n",
        "    # Check item's action genre weight\n",
        "    action_weight = item_genres[item_id, 0]\n",
        "    print(f\"  {i+1}. Item {item_id}: action_genre_weight={action_weight:.3f}, popularity={item_popularity[item_id]:.1f}\")"
