        "## 9. Implicit Feedback: BPR & Weighted ALS\n",
        "\n",
        "Alternative approaches for implicit feedback (no explicit ratings)."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Bayesian Personalized Ranking (BPR) loss implementation\n",
        "class BPRModel(tf.keras.Model):\n",
        "    def __init__(self, n_users, n_items, dim=64):\n",
        "        super().__init__()\n",
        "        self.user_emb = tf.keras.layers.Embedding(n_users, dim)\n",
        "        self.item_emb = tf.keras.layers.Embedding(n_items, dim)\n",
        "    \n",
        "    def call(self, user_ids, pos_item_ids, neg_item_ids):\n",
        "        u = self.user_emb(user_ids)\n",
        "        pos_i = self.item_emb(pos_item_ids)\n",
        "        neg_i = self.item_emb(neg_item_ids)\n",
        "        \n",
        "        pos_score = tf.reduce_sum(u * pos_i, axis=1)\n",
        "        neg_score = tf.reduce_sum(u * neg_i, axis=1)\n",
        "        \n",
        "        # BPR loss: -log(sigmoid(pos_score - neg_score))\n",
        "        loss = -tf.math.log(tf.nn.sigmoid(pos_score - neg_score) + 1e-8)\n",
        "        return tf.reduce_mean(loss)\n",
        "\n",
        "# Quick BPR training demo\n",
        "bpr = BPRModel(n_users, n_items, 64)\n",
        "bpr.compile(optimizer=tf.keras.optimizers.Adam(0.01))\n",
        "\n",
        "# Generate BPR triples\n",
        "bpr_data = []\n",
        "user_item_set = set(zip(interactions_df['user_id'], interactions_df['item_id']))\n",
        "for _ in range(50000):\n",
        "    u = np.random.randint(0, n_users)\n",
        "    pos_items = [i for (usr, i) in user_item_set if usr == u]\n",
        "    if not pos_items:\n",
        "        continue\n",
        "    pos_i = np.random.choice(pos_items)\n",
        "    neg_i = np.random.randint(0, n_items)\n",
        "    while (u, neg_i) in user_item_set:\n",
        "        neg_i = np.random.randint(0, n_items)\n",
        "    bpr_data.append((u, pos_i, neg_i))\n",
        "\n",
        "bpr_data = np.array(bpr_data)\n",
        "print(f\"BPR triples: {len(bpr_data)}\")\n",
        "\n",
        "# Train few steps\n",
        "batch_size = 1024\n",
        "for step in range(10):\n",
        "    idx = np.random.choice(len(bpr_data), batch_size)\n",
        "    u, pos, neg = bpr_data[idx].T\n",
        "    with tf.GradientTape() as tape:\n",
        "        loss = bpr(u, pos, neg)\n",
        "    grads = tape.gradient(loss, bpr.trainable_variables)\n",
        "    bpr.optimizer.apply_gradients(zip(grads, bpr.trainable_variables))\n",
        "    if step % 2 == 0:\n",
        "        print(f\"  Step {step}: BPR loss = {loss:.4f}\")"
      ]
    },
