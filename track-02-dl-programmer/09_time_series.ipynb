        "    ax.plot(test_dates, y_true, 'k-', label='Actual', linewidth=2)\n",
        "    ax.plot(test_dates, y_pred, '--', label=f'{name} Forecast', linewidth=2)\n",
        "    \n",
        "    # Prophet has prediction intervals\n",
        "    if name == 'Prophet':\n",
        "        ax.fill_between(test_dates, prophet_lower, prophet_upper, \n",
        "                        alpha=0.2, label='95% PI')\n",
        "    \n        "    ax.set_title(f'{name} Forecast vs Actual (MAE={results_df[results_df[\"Model\"]==name][\"MAE\"].values[0]:.2f})')\n",
        "    ax.legend()\n",
        "    ax.grid(True, alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5. Hierarchical Forecasting: Multiple Series with Reconciliation\n",
        "\n",
        "Real-world forecasting often involves hierarchies (e.g., product → category → store → region).\n",
        "Hierarchical forecasting methods:\n",
        "- **Bottom-up**: Forecast at bottom level, aggregate up\n",
        "- **Top-down**: Forecast at top, disaggregate down using proportions\n",
        "- **Middle-out**: Forecast at middle level\n",
        "- **MinTrace (Optimal Reconciliation)**: GLS/OLS/MinT reconciliation using covariance matrix\n",
        "\n",
        "We'll create a 3-level hierarchy: Total → Region (2) → Store (4) → Product (8) = 15 series"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Create hierarchical data\n",
        "np.random.seed(42)\n",
        "\n",
        "# Hierarchy: Total -> Region (2) -> Store (4) -> Product (8)\n",
        "regions = ['North', 'South']\n",
        "stores = ['Store_A', 'Store_B', 'Store_C', 'Store_D']\n",
        "products = ['Prod_1', 'Prod_2', 'Prod_3', 'Prod_4', 'Prod_5', 'Prod_6', 'Prod_7', 'Prod_8']\n",
        "\n",
        "# Assign stores to regions, products to stores\n",
        "store_region = {'Store_A': 'North', 'Store_B': 'North', 'Store_C': 'South', 'Store_D': 'South'}\n",
        "store_products = {\n",
        "    'Store_A': ['Prod_1', 'Prod_2'],\n",
        "    'Store_B': ['Prod_3', 'Prod_4'],\n",
        "    'Store_C': ['Prod_5', 'Prod_6'],\n",
        "    'Store_D': ['Prod_7', 'Prod_8']\n",
        "}\n",
        "\n",
        "n = 365  # 1 year\n",
        "dates = pd.date_range('2023-01-01', periods=n, freq='D')\n",
        "\n",
        "hierarchical_data = []\n",
        "\n",
        "# Generate bottom-level series (store-product)\n",
        "for store in stores:\n",
        "    for prod in store_products[store]:\n",
        "        base_demand = np.random.uniform(50, 200)\n",
        "        trend = 0.01 * np.arange(n)\n",
        "        seasonality = 20 * np.sin(2 * np.pi * np.arange(n) / 7)  # weekly\n",
        "        noise = np.random.normal(0, 5, n)\n",
        "        y = base_demand + trend + seasonality + noise\n",
        "        y = np.maximum(y, 0)  # no negative demand\n",
        "        \n",
        "        for i, date in enumerate(dates):\n",
        "            hierarchical_data.append({\n",
        "                'unique_id': f'{store}_{prod}',\n",
        "                'ds': date,\n",
        "                'y': y[i]\n",
        "            })\n",
        "\n",
        "hier_df = pd.DataFrame(hierarchical_data)\n",
        "\n",
        "# Split\n",
        "test_h = 30\n",
        "train_hier = hier_df.groupby('unique_id').apply(lambda x: x.iloc[:-test_h]).reset_index(drop=True)\n",
        "test_hier = hier_df.groupby('unique_id').apply(lambda x: x.iloc[-test_h:]).reset_index(drop=True)\n",
        "\n",
        "print(f\"Hierarchical data: {hier_df['unique_id'].nunique()} series, {len(hier_df)} total observations\")\n",
        "print(f\"Train: {len(train_hier)}, Test: {len(test_hier)}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Train base forecasts on bottom level using N-HiTS (fast)\n",
        "from neuralforecast.models import NHITS\n",
        "\n",
        "nhits_hier = NHITS(\n",
        "    h=test_h,\n",
        "    input_size=60,\n",
        "    n_blocks=2,\n",
        "    n_layers=2,\n",
        "    mlp_units=[32, 32],\n",
        "    learning_rate=1e-3,\n",
        "    max_steps=100,\n",
        "    random_seed=42\n",
        ")\n",
        "\n",
        "nf_hier = NeuralForecast(models=[nhits_hier], freq='D')\n",
        "nf_hier.fit(df=train_hier)\n",
        "\n",
        "# Base forecasts (bottom level only)\n",
        "base_forecasts = nf_hier.predict()\n",
        "base_forecasts = base_forecasts.reset_index()\n",
        "\n",
        "print(f\"Base forecasts shape: {base_forecasts.shape}\")\n",
        "print(base_forecasts.head())"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6. Hierarchical Reconciliation (MinTrace)\n",
        "\n",
        "Implement bottom-up and optimal reconciliation (MinTrace) using the hierarchy structure."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Build hierarchy summation matrix S (aggregation matrix)\n",
        "# Rows: all nodes (Total, Regions, Stores, Products), Cols: bottom-level nodes\n",
        "\n",
        "bottom_nodes = sorted(hier_df['unique_id'].unique())\n",
        "n_bottom = len(bottom_nodes)\n",
        "node_to_idx = {node: i for i, node in enumerate(bottom_nodes)}\n",
        "\n",
        "# All nodes in hierarchy\n",
        "all_nodes = ['Total'] + regions + stores + bottom_nodes\n",
        "n_all = len(all_nodes)\n",
        "\n",
        "# Summation matrix S: (n_all x n_bottom)\n",
        "S = np.zeros((n_all, n_bottom))\n",
        "\n",
        "# Total row: sum of all bottom\n",
        "S[0, :] = 1\n",
        "\n",
        "# Region rows\n",
        "for i, region in enumerate(regions):\n",
        "    region_stores = [s for s in stores if store_region[s] == region]\n",
        "    region_products = []\n",
        "    for s in region_stores:\n",
        "        region_products.extend(store_products[s])\n",
        "    for prod in region_products:\n",
        "        node = f'{s}_{prod}' if (s := [s for s in stores if prod in store_products[s]][0]) else None\n",
        "        # Better: find store for each product in this region\n",
        "        for s in region_stores:\n",
        "            if prod in store_products[s]:\n",
        "                idx = node_to_idx[f'{s}_{prod}']\n",
        "                S[1 + i, idx] = 1\n",
        "                break\n",
        "\n",
        "# Store rows\n",
        "for i, store in enumerate(stores):\n",
        "    for prod in store_products[store]:\n",
        "        idx = node_to_idx[f'{store}_{prod}']\n",
        "        S[1 + len(regions) + i, idx] = 1\n",
        "\n",
        "# Product rows (bottom level) - identity\n",
        "for i, node in enumerate(bottom_nodes):\n",
        "    S[1 + len(regions) + len(stores) + i, i] = 1\n",
        "\n",
        "print(f\"Summation matrix S shape: {S.shape}\")\n",
        "print(f\"Hierarchy levels: Total(1) + Regions({len(regions)}) + Stores({len(stores)}) + Bottom({n_bottom}) = {n_all}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Bottom-up reconciliation: aggregate base forecasts up\n",
        "base_preds = base_forecasts.pivot(index='ds', columns='unique_id', values='NHITS')\n",
        "base_preds = base_preds[bottom_nodes].values  # (horizon x n_bottom)\n",
        "\n",
        "# Bottom-up: y_hat_reconciled = S @ base_forecasts\n",
        "bu_forecasts = (S @ base_preds.T).T  # (horizon x n_all)\n",
        "\n",
        "# MinTrace (OLS reconciliation): G = (S^T S)^{-1} S^T\n",
        "# Reconciled = S @ G @ base_forecasts\n",
        "from numpy.linalg import inv\n",
        "\n",
        "G_ols = inv(S.T @ S) @ S.T\n",
        "mint_ols_forecasts = (S @ G_ols @ base_preds.T).T\n",
        "\n",
        "# MinTrace with sample covariance (W = diag(1/var) approx)\n",
        "residuals = train_hier.pivot(index='ds', columns='unique_id', values='y')\n",
        "residuals = residuals[bottom_nodes].values\n",
        "# Use in-sample residuals covariance\n",
        "W = np.diag(1.0 / (np.var(residuals, axis=0) + 1e-6))\n",
        "G_wls = inv(S.T @ W @ S) @ S.T @ W\n",
        "mint_wls_forecasts = (S @ G_wls @ base_preds.T).T\n",
        "\n",
        "print(\"Reconciliation complete:\")\n",
        "print(f\"  Bottom-up shape: {bu_forecasts.shape}\")\n",
        "print(f\"  MinTrace-OLS shape: {mint_ols_forecasts.shape}\")\n",
        "print(f\"  MinTrace-WLS shape: {mint_wls_forecasts.shape}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 7. Evaluate Hierarchical Forecasts\n",
        "\n",
        "Compare coherent (reconciled) vs incoherent (base) forecasts at each hierarchy level."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Prepare actuals at all levels\n",
        "actuals_all = {}\n",
        "\n",
        "# Total\n",
        "total_actual = test_hier.groupby('ds')['y'].sum().values\n",
        "actuals_all['Total'] = total_actual\n",
        "\n",
        "# Regions\n",
        "for region in regions:\n",
        "    region_stores = [s for s in stores if store_region[s] == region]\n",
        "    region_actual = test_hier[test_hier['unique_id'].str.startswith(tuple(region_stores))]\n",
        "    actuals_all[region] = region_actual.groupby('ds')['y'].sum().values\n",
        "\n",
        "# Stores\n",
        "for store in stores:\n",
        "    store_actual = test_hier[test_hier['unique_id'].str.startswith(store)]\n",
        "    actuals_all[store] = store_actual.groupby('ds')['y'].sum().values\n",
        "\n",
        "# Bottom level\n",
        "for node in bottom_nodes:\n",
        "    node_actual = test_hier[test_hier['unique_id'] == node].sort_values('ds')['y'].values\n",
        "    actuals_all[node] = node_actual\n",
        "\n",
        "# Evaluate at each level\n",
        "methods = {\n",
        "    'Base (incoherent)': base_preds,\n",
        "    'Bottom-Up': bu_forecasts,\n",
        "    'MinTrace-OLS': mint_ols_forecasts,\n",
        "    'MinTrace-WLS': mint_wls_forecasts\n",
        "}\n",
        "\n",
        "level_names = ['Total'] + regions + stores + bottom_nodes\n",
        "\n",
        "print(\"MAE by hierarchy level:\")\n",
        "for level_idx, level_name in enumerate(level_names):\n",
        "    y_true = actuals_all[level_name]\n",
        "    print(f\"\\n{level_name}:\")\n",
        "    for method_name, preds in methods.items():\n",
        "        if level_idx < preds.shape[1]:\n",
        "            y_pred = preds[:, level_idx]\n",
        "            mae = mean_absolute_error(y_true, y_pred)\n",
        "            print(f\"  {method_name}: {mae:.2f}\")"
      ]
