        "## 9. Cross-Validation for Time Series\n",
        "\n",
        "Time series cross-validation (rolling origin) to assess model stability."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def rolling_cv(df, model_class, model_params, n_splits=5, horizon=30, step=30):\n",
        "    \"\"\"Rolling origin cross-validation for time series\"\"\"\n",
        "    n = len(df)\n",
        "    min_train = n - n_splits * step - horizon\n",
        "    \n",
        "    cv_results = []\n",
        "    \n",
        "    for i in range(n_splits):\n",
        "        train_end = min_train + i * step\n",
        "        test_end = train_end + horizon\n",
        "        \n",
        "        if test_end > n:\n",
        "            break\n",
        "            \n",
        "        train_fold = df.iloc[:train_end]\n",
        "        test_fold = df.iloc[train_end:test_end]\n",
        "        \n",
        "        # Train\n",
        "        model = model_class(**model_params)\n",
        "        nf = NeuralForecast(models=[model], freq='D')\n",
        "        nf.fit(df=train_fold)\n",
        "        \n",
        "        # Predict\n",
        "        pred = nf.predict()\n",
        "        pred = pred.reset_index()\n",
        "        \n",
        "        y_true = test_fold['y'].values\n",
        "        y_pred = pred[pred['unique_id'] == 'series_1'][model.__class__.__name__].values\n",
        "        \n",
        "        if len(y_pred) == len(y_true):\n",
        "            mae = mean_absolute_error(y_true, y_pred)\n",
        "            cv_results.append(mae)\n",
        "    \n",
        "    return cv_results\n",
        "\n",
        "# Run CV for N-HiTS\n",
        "cv_params = dict(h=30, input_size=60, n_blocks=2, n_layers=2, mlp_units=[32, 32],\n",
        "                 learning_rate=1e-3, max_steps=50, random_seed=42)\n",
        "\n",
        "cv_maes = rolling_cv(train_df, NHITS, cv_params, n_splits=4, horizon=30, step=30)\n",
        "print(f\"Rolling CV MAEs: {cv_maes}\")\n",
        "print(f\"Mean CV MAE: {np.mean(cv_maes):.3f} ± {np.std(cv_maes):.3f}\")"
      ]
    },
