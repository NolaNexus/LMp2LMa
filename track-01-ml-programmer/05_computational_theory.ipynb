   "source": [
    "## 1. Finite Automata (DFA & NFA)\n",
    "\n",
    "A **finite automaton** is a simple computational model with a finite set of states, transitions, and accepting states. DFAs (deterministic) and NFAs (non-deterministic) recognize regular languages — the simplest class in the Chomsky hierarchy.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "class DFAEvenOnes:\n",
    "    \"\"\"DFA accepting binary strings with even number of 1s.\n",
    "\n",
    "    States: q0 (even count so far), q1 (odd count so far)\n",
    "    Start: q0 (0 ones is even)\n",
    "    Accept: q0\n",
    "    Transitions:\n",
    "      - From q0, read '0' -> stay in q0\n",
    "      - From q0, read '1' -> go to q1\n",
    "      - From q1, read '0' -> stay in q1\n",
    "      - From q1, read '1' -> go to q0\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self):\n",
    "        self.states = {'q0', 'q1'}\n",
    "        self.start_state = 'q0'\n",
    "        self.accept_states = {'q0'}\n",
    "        # Transition function: (state, input) -> next_state\n",
    "        self.transitions = {\n",
    "            ('q0', '0'): 'q0',\n",
    "            ('q0', '1'): 'q1',\n",
    "            ('q1', '0'): 'q1',\n",
    "            ('q1', '1'): 'q0',\n",
    "        }\n",
 "    \n",
    "    def accepts(self, string):\n",
    "        \"\"\"Return True if the DFA accepts the input string.\"\"\"\n",
    "        state = self.start_state\n",
    "        for char in string:\n",
    "            state = self.transitions[(state, char)]\n",
    "        return state in self.accept_states\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.1 DFA: Binary Even Parity Detector\n",
    "\n",
    "A DFA that accepts binary strings with an even number of 1s.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Test the DFA\ndfa = DFAEvenOnes()\ntest_strings = [\n",
    "    (\"\", \"empty string (0 ones, even)\"),\n",
    "    (\"0\", \"single zero\"),\n",
    "    (\"1\", \"single one (odd)\"),\n",
    "    (\"00\", \"two zeros\"),\n",
    "    (\"01\", \"zero then one\"),\n",
    "    (\"10\", \"one then zero\"),\n",
    "    (\"11\", \"two ones (even)\"),\n",
    "    (\"101\", \"one-zero-one (even)\"),\n",
    "    (\"111\", \"three ones (odd)\"),\n",
    "    (\"01010\", \"alternating (even)\"),\n",
 "]\n",
 "\n",
    "print(\"DFA Even-Odd Parity Detector\")\n",
    "print(\"=\" * 60)\n",
    "for s, desc in test_strings:\n",
    "    result = dfa.accepts(s)\n",
    "    print(f\"  '{s:>8s}' : {desc:40s} -> {'ACCEPT' if result else 'REJECT'}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.2 Visualizing the DFA\n",
    "\n",
    "DOT format for graph visualization.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "def draw_dfa(dfa, filename=\"dfa_even_ones\"):\n",
    "    \"\"\"Draw the DFA as a simple graph.\"\"\"\n",
    "    state_colors = {'q0': 'lightgreen', 'q1': 'lightcoral'}\n",
    "\n",
    "    dot_lines = []\n",
    "    dot_lines.append(\"digraph DFA {\")\n",
    "    dot_lines.append(\"  rankdir=LR;\")\n",
    "    dot_lines.append(\"  size=\"4,4\";\")\n",
    "    dot_lines.append(\"  node [shape=circle, style=filled];\")\n",
    "\n",
    "    # Start node arrow\n",
    "    dot_lines.append(f\"  start [shape=none label=\"\\\"\"\"];\")\n",
    "    dot_lines.append(f\"  {dfa.start_state} [shape=circle, style=filled, color={state_colors[dfa.start_state]}, label=\"{dfa.start_state}\"];\")\n",
    "\n",
    "    # Accept state double circle\n",
    "    for s in dfa.accept_states:\n",
    "        dot_lines.append(f\"  {s} [shape=doublecircle, label=\"{s}\"];\")\n",
    "\n",
    "    # Non-accept state\n",
    "    for s in dfa.states - dfa.accept_states:\n",
    "        dot_lines.append(f\"  {s} [shape=circle, style=filled, color={state_colors[s]}, label=\"{s}\"];\")\n",
    "\n",
    "    # Transition edges\n",
    "    for (from_state, inp), to_state in dfa.transitions.items():\n",
    "        label = f\"'{inp}'\" if inp else inp\n",
    "        dot_lines.append(f\"  {from_state} -> {to_state} [label={label}];\")\n",
    "\n",
    "    dot_lines.append(\"}\")\n",
    "\n",
    "    with open(f\"{filename}.dot\", 'w') as f:\n",
    "        f.write('\\n'.join(dot_lines))\n",
    "    print(f\"DOT file written: {filename}.dot\")\n",
    "    print(\"Render with: dot -Tpng dfa_even_ones.dot -o dfa_even_ones.png\")\n",
 "\n",
    "draw_dfa(dfa)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Verify: all accepted strings have even number of 1s\n",
    "print(\"\\nVerification: Checking all 4-bit strings\")\n",
    "all_even = sum(1 for i in range(16) if dfa.accepts(format(i, '04b')))\n",
    "print(f\"  {all_even}/16 four-bit strings accepted (expected 8 with even parity)\")\n"
   ]
