digraph DFA {
  rankdir=LR;
  size="4,4";
  node [shape=circle, style=filled];
  start [shape=none label=""]
  q0 [shape=circle, style=filled, color=lightgreen, label="q0"];
  q0 [shape=doublecircle, label="q0"];
  q1 [shape=circle, style=filled, color=lightcoral, label="q1"];
  q0 -> q0 [label='0'];
  q0 -> q1 [label='1'];
  q1 -> q1 [label='0'];
  q1 -> q0 [label='1'];
}